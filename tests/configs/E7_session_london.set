; EURUSD: alternate session window (07-16 server time, London-centric)
; instead of gold's derived 12-20 window. EURUSD's most active hours
; are plausibly earlier than gold's - this is a hypothesis to test,
; not a known-good value.
; Run: python autotest.py --model 1 --symbol EURUSD --from 2025.07.01 --to 2025.12.31 E7_session_london

InpSymbol=
InpMagic=20260707
InpTF=15
InpUseSymbolOverrides=true
InpRiskPerTrade=1.0
InpMaxDailyLoss=3.0
InpMaxTotalDD=10.0
InpMaxConsecLosses=3
InpMaxPositions=1
InpMinRR=1.5
InpAtrStopFloor=1.5
InpBreakevenR=1.0
InpTrailAtrMult=2.0
InpTrailMode=0
InpFallbackRR=2.0
InpTpCapAtr=3.0
InpPartialPct=50.0
InpGapBufferAtr=0.5
InpGapLookback=20
InpVolFullRatio=1.0
InpVolMinRatio=2.0
InpVolRiskFloor=1.0
InpMinScore=0.55
InpSetupMaxAge=3
InpSwingWing=3
InpQmZoneAtr=0.5
InpProfileBin=0.20
InpSessionStart=7
InpSessionEnd=16
InpMaxChaseAtr=0.75
InpRetestTolAtr=0.25
InpRetestMaxBars=8
InpMinAdx=0
InpNewsFilter=true
InpNewsBlockMin=30
InpMinRelVol=1.0
InpRelVolDays=20
InpOutlierZ=3.5
InpTickBudgetUs=3000
InpTimerBudgetUs=50000
InpResetRiskState=false
InpBreakEntryMode=0
InpRetestLimit=true
InpStopBufferAtr=0.05
InpBeAtrTrigger=0
InpLockStartPct=0
InpLockPct=50
InpNewsFlattenMin=0
InpFridayFlattenHour=22
InpTestTag=E7_session_london
